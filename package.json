{
  "name": "peartube-soulseek",
  "version": "0.1.0",
  "description": "Standalone Rust Soulseek client library exposed as a native Bare addon",
  "license": "MIT",
  "addon": true,
  "exports": {
    "./package": "./package.json",
    ".": "./js/index.js"
  },
  "files": [
    "js",
    "binding.js",
    "soulseek",
    "src",
    "Cargo.toml",
    "Cargo.lock",
    "CMakeLists.txt",
    "prebuilds"
  ],
  "scripts": {
    "test:bare": "node -e \"const { execFileSync } = require('child_process'); execFileSync(require('bare-runtime')(), ['test/addon.test.js'], { stdio: 'inherit' })\""
  },
  "engines": {
    "bare": ">=1.16.0"
  },
  "devDependencies": {
    "b4a": "^1.9.0",
    "bare-addon-resolve": "^1.12.0",
    "bare-assert": "^1.3.0",
    "bare-events": "^2.9.2",
    "bare-fs": "^4.8.4",
    "bare-net": "^2.3.3",
    "bare-os": "^3.9.4",
    "bare-path": "^3.1.3",
    "bare-runtime": "^1.37.1",
    "bare-url": "^2.5.7",
    "bare-zlib": "^1.4.1",
    "cmake-bare": "^1.14.1",
    "cmake-fetch": "^1.5.3",
    "cmake-npm": "^1.2.0"
  }
}
